<Window x:Name="scrOptions" x:Class="Work_Here.Options"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Work_Here"
        mc:Ignorable="d"
        Title="Options" Height="318.779" Width="512.725" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" WindowStyle="ThreeDBorderWindow">
    <Grid Background="White">
        <Button x:Name="btnEasy" Content="Easy" HorizontalAlignment="Left" Margin="10,27,0,0" VerticalAlignment="Top" Width="100" Height="60" Click="btnEasy_Click" Padding="1" BorderThickness="0" Cursor="Hand" Background="#FFE6E6E6" FontFamily="Comic Sans MS" FontSize="16"/>
        <Button x:Name="btnMedium" Content="Medium" HorizontalAlignment="Left" Margin="10,115,0,0" VerticalAlignment="Top" Width="100" Height="60" Click="btnMedium_Click" BorderThickness="0" Cursor="Hand" Background="#FFE6E6E6" FontFamily="Comic Sans MS" FontSize="16"/>
        <Button x:Name="btnHard" Content="Hard" HorizontalAlignment="Left" Margin="10,208,0,0" VerticalAlignment="Top" Width="100" Height="60" Click="btnHard_Click" BorderThickness="0" Cursor="Hand" Background="#FFE6E6E6" FontFamily="Comic Sans MS" FontSize="16"/>
        <Grid x:Name="grdCategory" HorizontalAlignment="Left" Height="285" Margin="127,0,0,0" VerticalAlignment="Top" Width="374" Background="White">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Image HorizontalAlignment="Left" Height="116" Margin="186,67,0,0" VerticalAlignment="Top" Width="178" Source="City.jpg"/>
            <Button x:Name="btnAnimals" Content="Animals" HorizontalAlignment="Left" VerticalAlignment="Top" Width="130" Margin="51,10,0,0" Height="33" Click="btnAnimals_Click" BorderThickness="0" HorizontalContentAlignment="Center" Cursor="Hand" Background="{x:Null}" FontFamily="Comic Sans MS" FontSize="14" FontWeight="Bold" RenderTransformOrigin="0.5,0.5">
                <Button.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform Angle="-5.599"/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Button.RenderTransform>
            </Button>
            <Button x:Name="btnMedia" Content="Media" HorizontalAlignment="Left" Margin="96,73,0,0" VerticalAlignment="Top" Width="130" Height="37" Click="btnMedia_Click" BorderThickness="0" HorizontalContentAlignment="Center" Cursor="Hand" FontFamily="Comic Sans MS" FontSize="14" Background="{x:Null}" FontWeight="Bold" RenderTransformOrigin="0.5,0.5">
                <Button.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform Angle="4.324"/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Button.RenderTransform>
            </Button>
            <Button x:Name="btnScience" Content="Science" HorizontalAlignment="Left" Margin="73,176,0,0" VerticalAlignment="Top" Width="130" Height="38" Click="btnScience_Click" BorderThickness="0" HorizontalContentAlignment="Center" Cursor="Hand" FontFamily="Comic Sans MS" FontSize="14" Background="{x:Null}" FontWeight="Bold" RenderTransformOrigin="0.5,0.5">
                <Button.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform Angle="8.796"/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Button.RenderTransform>
            </Button>
            <Button x:Name="btnRegions" Content="Countries / Cities" HorizontalAlignment="Left" Margin="-40,115,0,0" VerticalAlignment="Top" Width="306" Height="52" Click="btnRegions_Click" BorderThickness="0" HorizontalContentAlignment="Center" Cursor="Hand" FontFamily="Comic Sans MS" FontSize="14" Background="{x:Null}" FontWeight="Bold" RenderTransformOrigin="0.5,0.5">
                <Button.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform Angle="-3.935"/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Button.RenderTransform>
            </Button>
            <Button x:Name="btnFood" Content="Food" HorizontalAlignment="Left" Margin="108,229,0,0" VerticalAlignment="Top" Width="130" Height="37" Click="btnFood_Click" BorderThickness="0" HorizontalContentAlignment="Center" Cursor="Hand" FontFamily="Comic Sans MS" FontSize="14" Background="{x:Null}" FontWeight="Bold" RenderTransformOrigin="0.5,0.5">
                <Button.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform Angle="-8.201"/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Button.RenderTransform>
            </Button>
            <Image Margin="205,-3,65,220" Source="animal-templates-to-print-onwebioinnovateco-coloring-pages-for-kids-animal-outlines-to-print.jpg" Stretch="Fill" RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform Angle="13.333"/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>
            <Image Margin="17,47,272,163" Source="television-clipart-outline-8.png" Stretch="Fill"/>
            <Image Margin="31,159,295,60" Source="beaker-drawing-outline-3.png" Stretch="Fill"/>
            <Image Margin="220,211,61,10" Source="burger-clipart-outline.png" Stretch="Fill"/>
        </Grid>

    </Grid>
</Window>
