<Window x:Class="Work_Here.Profile"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Work_Here"
        mc:Ignorable="d"
        Title="Profile" Height="187.206" Width="450" WindowStartupLocation="CenterScreen">
    <Grid RenderTransformOrigin="0.5,0.5" Background="White">
        <Button x:Name="btnNew" Content="NEW ACCOUNT" HorizontalAlignment="Left" VerticalAlignment="Top" Width="140" Height="30" Click="btnNew_Click" FontFamily="Comic Sans MS" BorderThickness="0" Margin="10,8,0,0" Background="#FFCBCBCB" Cursor="Hand"/>
        <Button x:Name="btnSign" Content="LOAD DATA" HorizontalAlignment="Left" Margin="291,10,0,0" VerticalAlignment="Top" Width="141" Height="30" Click="btnSign_Click" FontFamily="Comic Sans MS" BorderThickness="0" Background="#FFCBCBCB" Cursor="Hand"/>
        <Label x:Name="lblID" Content="ID" HorizontalAlignment="Left" Margin="10,42,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="txtID" HorizontalAlignment="Right" Height="26" Margin="0,40,246,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>
        <Label x:Name="lblUser" Content="UserName" HorizontalAlignment="Left" Margin="10,77,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="txtUserEnter" HorizontalAlignment="Left" Height="26" Margin="312,74,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120" TextChanged="txtUserEnter_TextChanged"/>
        <Button x:Name="btnCreate" Content="Create" HorizontalAlignment="Left" Margin="10,112,0,0" VerticalAlignment="Top" Width="140" Height="30" Click="btnCreate_Click" FontFamily="Comic Sans MS" BorderThickness="0" Background="#FFCBCBCB" Cursor="Hand"/>
        <Button x:Name="btnEnter" Content="Enter" HorizontalAlignment="Left" Margin="291,0,0,14" VerticalAlignment="Bottom" Width="140" Height="30" Click="btnEnter_Click" FontFamily="Comic Sans MS" BorderThickness="0" Background="#FFCBCBCB" Cursor="Hand"/>
        <Label x:Name="lblUserEnter" Content="UserName" HorizontalAlignment="Left" Margin="236,78,0,0" VerticalAlignment="Top" RenderTransformOrigin="4.783,0.243"/>
        <TextBox x:Name="txtUserCreate" HorizontalAlignment="Left" Height="26" Margin="76,74,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>

    </Grid>
</Window>
