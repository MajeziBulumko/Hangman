<Window x:Name="Menu" x:Class="Work_Here.Quick_Play"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Work_Here"
        mc:Ignorable="d"
        Title="Main Menu" Height="356.267" Width="497.965" WindowStartupLocation="CenterScreen">
    <Grid Background="White">

        <Image HorizontalAlignment="Left" Height="311" Margin="0,66,0,-52" VerticalAlignment="Top" Width="455" Source="Mainmenu.jpg" RenderTransformOrigin="0.5,0.5">
            <Image.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="10.764"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Image.RenderTransform>
        </Image>

        <Button x:Name="btnCareer" Content="Career Mode" HorizontalAlignment="Left" Margin="285,139,0,0" VerticalAlignment="Top" Width="177" Height="85" Background="{x:Null}" Click="btnCareer_Click" FontSize="22" FontFamily="Comic Sans MS" BorderThickness="0" Cursor="Hand" FontWeight="Bold" RenderTransformOrigin="0.5,0.5">
            <Button.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="-6.159"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Button.RenderTransform>
        </Button>
        <Button x:Name="btnQuickPlay" Content="Quick Play" HorizontalAlignment="Left" Margin="206,73,0,0" VerticalAlignment="Top" Width="190" Height="86" Background="{x:Null}" BorderBrush="#FFD8D80D" Click="btnQuickPlay_Click" BorderThickness="0" FontFamily="Comic Sans MS" FontSize="22" Cursor="Hand" FontWeight="Bold" RenderTransformOrigin="0.5,0.5">
            <Button.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="7.85"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Button.RenderTransform>
        </Button>

    </Grid>
</Window>
